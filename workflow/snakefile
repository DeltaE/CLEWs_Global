import os
import yaml
from snakemake.utils import min_version
min_version("8.0")


# configuration

configfile: 'config/config.yaml'

# helper functions

def get_otoole_data(otoole_config: str, var: str) -> list[str]:
    """Gets parameter/result files to be created"""

    assert var in ("param", "result", "set")

    with open(otoole_config) as f:
        otoole = yaml.safe_load(f)

    results = [x for x in otoole if otoole[x]["type"] == var]

    # no result calcualtions
    missing = [
        # storage investment not guaranteed
        "NewStorageCapacity",
        "TotalDiscountedStorageCost",
        "SalvageValueStorage",
        "CapitalInvestmentStorage",
        "DiscountedCapitalInvestmentStorage",
        "DiscountedSalvageValueStorage",
        "DiscountedCostByStorage",
        # storage levels not guaranteed
        "StorageLevelSeasonStart",
        "StorageLevelSeasonFinish",
        "StorageLevelYearStart",
        "StorageLevelYearFinish",
        "StorageLevelDayTypeStart",
        "StorageLevelDayTypeFinish",
        "StorageLowerLimit",
        "StorageUpperLimit",
        "CapitalInvestmentStorage",
        "DiscountedCapitalInvestmentStorage",
        "DiscountedCostByStorage",
        "DiscountedSalvageValueStorage",
        "NetChargeWithinDay",
        "NetChargeWithinYear",
        # other missing calcs
        "NumberOfNewTechnologyUnits",
        "Trade",
        "ModelPeriodEmissions",
    ]

    return [x for x in results if x not in missing]

# yaml file configs for OG
OSEMOSYS_DIR = config["osemosys"]["dir"]
OSEMOSYS_JOBS = config["osemosys"]["jobs"]
GEOCLEWS_DIR = config["geoclews"]["dir"]
OTOOLE_YAML = f"{OSEMOSYS_DIR}/resources/otoole.yaml"
OTOOLE_PARAMS = get_otoole_data(OTOOLE_YAML, "param")
CLEWS_YAML = "config/clews_config/clewsy_otoole_config.yaml"
CLEWS_RESULTS = get_otoole_data(CLEWS_YAML, "result")

# constants

OTOOLE_YAML = f"{OSEMOSYS_DIR}/resources/otoole.yaml"
CLEWS_YAML = "config/clews_config/clewsy_otoole_config.yaml"

COUNTRIES = config["geographic_scope"]

rule all:
    input:
        results_file = expand(f'results/{{scenario}}/results/{{result_file}}.csv', scenario=config['scenario'], result_file = CLEWS_RESULTS)

rule run_osemosys_submodule:
    output:
        osemosys_global_result = expand(f'{OSEMOSYS_DIR}/results/{{scenario}}/data/{{csv}}.csv', scenario=config['scenario'], csv=OTOOLE_PARAMS)
    conda: "osemosys-global"
    script:
        "scripts/og.py"

rule geoclews:
    message:
        "Run GeoCLEWs..."
    output:
        geoclews_results = expand(f"{GEOCLEWS_DIR}/GAEZ_Processing/Data/output/{{scenario}}/summary_stats/{{region}}_LandCover_byCluster_summary.csv", scenario=config['scenario'], region=config['number_of_clusters'].keys())
    conda:
        "GeoCLEWs"
    script:
        "scripts/geoclews.py"

rule copy:
    message:
        "Copying output CSV data..."
    output:
        og_results_copied = expand(f'results/{{scenario}}/osemosys_global/{{csv}}.csv', scenario=config['scenario'], csv=OTOOLE_PARAMS),
        geoclews_results_copied = expand(f"results/{{scenario}}/geoclews/summary_stats/{{region}}_LandCover_byCluster_summary.csv", scenario=config['scenario'], region=config['number_of_clusters'].keys())

    input:
        osemosys_global_result = expand(f'{OSEMOSYS_DIR}/results/{{scenario}}/data/{{csv}}.csv', scenario=config['scenario'], csv=OTOOLE_PARAMS),
        geoclews_results = expand(f"{GEOCLEWS_DIR}/GAEZ_Processing/Data/output/{{scenario}}/summary_stats/{{region}}_LandCover_byCluster_summary.csv", scenario=config['scenario'], region=config['number_of_clusters'].keys())
    script:
        "scripts/copy_results.py"

rule clewsy:
    message:
        "Running clewsy to process..."
    input:
        og_results_copied = expand(f'results/{{scenario}}/osemosys_global/{{csv}}.csv', scenario=config['scenario'], csv=OTOOLE_PARAMS),
        geoclews_results_copied = expand(f"results/{{scenario}}/geoclews/summary_stats/{{region}}_LandCover_byCluster_summary.csv", scenario=config['scenario'], region=config['number_of_clusters'].keys())
    output:
        results_file = expand(f'results/{{scenario}}/results/{{result_file}}.csv', scenario=config['scenario'], result_file = CLEWS_RESULTS)
    script:
        "scripts/clewsy.py"